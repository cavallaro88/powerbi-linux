#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
import sys
from pathlib import Path
# A source checkout runs packaging/pbi-linux; an installed /usr/bin/pbi-linux
# always uses the packaged code, never a pbi_linux that happens to be in /usr/src.
script = Path(__file__).resolve()
source = script.parents[1] / 'src'
checkout = script.parent.name == 'packaging' and (source / 'pbi_linux').is_dir()
sys.path.insert(0, str(source) if checkout else '/usr/share/powerbi-linux/src')
from pbi_linux.cli import main
raise SystemExit(main())
