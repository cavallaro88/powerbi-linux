+static HRESULT WINAPI visual_SetContent(IDCompositionVisual2 *iface, IUnknown *content)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+
+    TRACE("%p, %p.\n", iface, content);
+
+    if (content) IUnknown_AddRef(content);
+    if (visual->content) IUnknown_Release(visual->content);
+    visual->content = content;
+
+    if (content)
+    {
+        IDXGISwapChain *swapchain;
+        if (SUCCEEDED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain, (void **)&swapchain)))
+        {
+            DXGI_SWAP_CHAIN_DESC d = {0};
+            IDXGISwapChain_GetDesc(swapchain, &d);
+            ERR("neutron-setcontent: visual=%p SWAPCHAIN=%p %ux%u fmt=%d buffers=%u swapeffect=%d\n",
+                iface, swapchain, d.BufferDesc.Width, d.BufferDesc.Height, d.BufferDesc.Format,
+                d.BufferCount, d.SwapEffect);
+            IDXGISwapChain_Release(swapchain);
+        }
+        else
+        {
+            /* If CEF presents the panel via an IDCompositionSurface (not a swapchain) we currently drop
+             * it -> the panel reads white. Log which interfaces this content DOES expose so we know what
+             * to handle. */
+            struct { const char *n; const GUID *iid; } probes[] = {
+                {"IDCompositionSurface",        &IID_IDCompositionSurface},
+                {"IDCompositionVirtualSurface", &IID_IDCompositionVirtualSurface},
+                {"IDXGIResource",               &IID_IDXGIResource},
+                {"ID3D11Texture2D",             &IID_ID3D11Texture2D},
+            };
+            char hit[256] = {0};
+            unsigned k;
+            for (k = 0; k < ARRAY_SIZE(probes); k++)
+            {
+                void *p = NULL;
+                if (SUCCEEDED(IUnknown_QueryInterface(content, probes[k].iid, &p)) && p)
+                {
+                    strcat(hit, probes[k].n); strcat(hit, " ");
+                    IUnknown_Release((IUnknown *)p);
+                }
+            }
+            ERR("neutron-setcontent: visual=%p NON-SWAPCHAIN content=%p exposes: [%s] (surface content NOT handled -> white)\n",
+                iface, content, hit[0] ? hit : "unknown");
+        }
+    }
+    return S_OK;
+}
