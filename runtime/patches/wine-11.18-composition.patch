+/* NEUTRON gpu-churn fix (Premiere Edit<->Export stall):
+ * The final IDXGISwapChain_Release of a RETIRED swapchain must never run
+ * synchronously on the app's Present thread, and never under presentations_cs.
+ *
+ * Proven failure (gpu-churn.log, 2026-07-23): on a workspace switch CEF's GPU
+ * process (CEPHtmlEngine --type=gpu-process) recreates its swapchain for the
+ * resized panel; the next Present re-registers via dcomp_register_external ->
+ * register_presentation, which (a) took presentations_cs and (b) dropped the
+ * LAST reference to the old DXVK swapchain in place. DXVK's teardown
+ * (~D3D11SwapChain -> Presenter::destroyResources) waits UNBOUNDED on
+ * m_surfaceCond until !m_presentPending -- a present that will never complete
+ * once the app has abandoned the old swapchain mid-frame. The GPU process main
+ * thread hung >=120s holding presentations_cs (RtlpWaitForCriticalSection
+ * "blocked by <main tid>" at dcomp+0x10260 == presentations_cs), Chromium
+ * killed it (exit_code=2) and respawned it; the multi-second Vulkan re-init is
+ * the visible stall.
+ *
+ * Fix: swap the new swapchain in under the lock, then hand the old one to a
+ * one-shot reaper thread. If DXVK's teardown wait never satisfies, only the
+ * reaper idles (0%% CPU); the render thread, the blit thread and the process
+ * survive. Worst case is one parked thread + one leaked presenter per
+ * workspace switch, instead of GPU-process death. */
+struct swapchain_reaper_item
+{
+    IDXGISwapChain *swapchain;
+    ID3D11Texture2D *staging;
+};
+
+static DWORD WINAPI swapchain_reaper_proc(void *arg)
+{
+    struct swapchain_reaper_item *item = arg;
+    ULONGLONG t0 = GetTickCount64();
+
+    if (item->staging) ID3D11Texture2D_Release(item->staging);
+    if (item->swapchain) IDXGISwapChain_Release(item->swapchain);
+
+    /* ERR on purpose (project instrumentation style): tells the A/B log whether
+     * retired swapchains actually finish releasing (fast = fully resolved) or
+     * this line never appears (reaper parked = quarantined DXVK teardown hang,
+     * potential VRAM leak per switch — investigate DXVK m_presentPending). */
+    ERR("neutron-reap: released swapchain=%p staging=%p in %llu ms\n",
+        item->swapchain, item->staging, GetTickCount64() - t0);
+    free(item);
+    return 0;
+}
+
+static void release_swapchain_async(IDXGISwapChain *swapchain, ID3D11Texture2D *staging)
+{
+    struct swapchain_reaper_item *item;
+    HANDLE thread;
+
+    if (!swapchain && !staging) return;
+
+    if ((item = calloc(1, sizeof(*item))))
+    {
+        item->swapchain = swapchain;
+        item->staging = staging;
+        if ((thread = CreateThread(NULL, 0, swapchain_reaper_proc, item, 0, NULL)))
+        {
+            ERR("neutron-reap: queued async release of retired swapchain=%p staging=%p\n",
+                swapchain, staging);
+            CloseHandle(thread);
+            return;
+        }
+        free(item);
+    }
+    /* Allocation/thread failure: fall back to the old synchronous release. */
+    if (staging) ID3D11Texture2D_Release(staging);
+    if (swapchain) IDXGISwapChain_Release(swapchain);
+}
+
+static void blit_swapchain_to_hwnd(struct presentation *p)
+{
+    IDXGISwapChain *swapchain = p->swapchain;
+    HWND hwnd = p->present_hwnd;
+    ID3D11Texture2D *backbuffer = NULL, *staging = NULL;
+    ID3D11Device *d3d_device = NULL;
+    ID3D11DeviceContext *ctx = NULL;
+    ID3D10Multithread *mt = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    BITMAPINFO bmi;
+    void *packed = NULL;
+    HDC hdc;
+    RECT rc;
+    UINT y;
+    HRESULT hr;
+    static LONG diag_n;
+    LONG n;
+    BOOL diag;
+    /* volatile so their post-__TRY values survive a page fault in the guarded block
+     * (must not skip the mt Leave -> would deadlock the app's resize). */
+    volatile BOOL mt_entered = FALSE, have_pixels = FALSE;
+
+    n = InterlockedIncrement(&diag_n);
+    diag = (n % 120 == 1);
+
+    /* NEUTRON: the app can resize/recreate this swapchain from another thread on
+     * maximize/un-maximize; our read then races its backbuffer teardown and faults
+     * deep in the D3D/DXGI/vkd3d layer (observed: unhandled AV in d3d12core on
+     * un-maximize). Guard the whole swapchain access with a page-fault handler and
+     * just drop the frame — this async blit is best-effort. The swapchain and device
+     * are ref-held (alive), so leaving the mt lock + releasing the objects afterwards
+     * stays safe; only the backbuffer contents are transiently invalid. */
+    __TRY
+    {
+        UINT count = 0;
+        if (!p->synchronous && p->cross_proc && SUCCEEDED(IDXGISwapChain_GetLastPresentCount(swapchain, &count)) &&
+            p->have_present_count && count == p->last_present_count)
+        {
+            /* No new frame presented since our last blit: skip. */
+        }
+        else
+        {
+            if (p->cross_proc)
+            {
+                p->last_present_count = count;
+                p->have_present_count = TRUE;
+                if (!p->t_first_present)
+                {
+                    p->t_first_present = TRUE;
+                    ERR("neutron-time: sc=%p host=%p FIRST-PRESENT tick=%llu presentcount=%u\n",
+                        swapchain, hwnd, GetTickCount64(), count);
+                }
+            }
+
+            if (FAILED(hr = IDXGISwapChain_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&backbuffer)))
+            {
+                if (diag) ERR("diag: GetBuffer failed hr %#lx\n", hr);
+            }
+            else
+            {
+                ID3D11Texture2D_GetDevice(backbuffer, &d3d_device);
+                if (d3d_device)
+                {
+                    ID3D11Device_GetImmediateContext(d3d_device, &ctx);
+
+                    if (FAILED(ID3D11DeviceContext_QueryInterface(ctx, &IID_ID3D10Multithread, (void **)&mt)))
+                        ID3D11Device_QueryInterface(d3d_device, &IID_ID3D10Multithread, (void **)&mt);
+                    if (mt)
+                    {
+                        ID3D10Multithread_SetMultithreadProtected(mt, TRUE);
+                        ID3D10Multithread_Enter(mt);
+                        mt_entered = TRUE;
+                    }
+
+                    ID3D11Texture2D_GetDesc(backbuffer, &desc);
+                    desc.Usage = D3D11_USAGE_STAGING;
+                    desc.BindFlags = 0;
+                    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+                    desc.MiscFlags = 0;
+                    /* NEUTRON M1a: reuse a cached staging texture; (re)create only on a size
+                     * change instead of allocating+freeing ~33MB (at 4K) every 16ms tick. The
+                     * cache owns the ref (freed on size change / swapchain change / unregister);
+                     * `staging` here is a borrow and is NOT released in `done`. */
+                    if (!(p->staging && p->staging_w == desc.Width && p->staging_h == desc.Height))
+                    {
+                        if (p->staging) { ID3D11Texture2D_Release(p->staging); p->staging = NULL; }
+                        if (FAILED(hr = ID3D11Device_CreateTexture2D(d3d_device, &desc, NULL, &p->staging)))
+                        {
+                            if (diag) ERR("diag: CreateTexture2D(staging) failed hr %#lx\n", hr);
+                            p->staging = NULL;
+                        }
+                        else { p->staging_w = desc.Width; p->staging_h = desc.Height; }
+                    }
+                    staging = p->staging;
+                    if (staging)
+                    {
+                        ID3D11DeviceContext_CopyResource(ctx, (ID3D11Resource *)staging, (ID3D11Resource *)backbuffer);
+                        if (FAILED(hr = ID3D11DeviceContext_Map(ctx, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
+                        {
+                            if (diag) ERR("diag: Map failed hr %#lx\n", hr);
+                        }
+                        else
+                        {
+                            if ((packed = malloc((SIZE_T)desc.Width * 4 * desc.Height)))
+                            {
+                                for (y = 0; y < desc.Height; y++)
+                                    memcpy((BYTE *)packed + (SIZE_T)y * desc.Width * 4,
+                                           (BYTE *)map.pData + (SIZE_T)y * map.RowPitch,
+                                           (SIZE_T)desc.Width * 4);
+                            }
+                            ID3D11DeviceContext_Unmap(ctx, (ID3D11Resource *)staging, 0);
+                            have_pixels = TRUE;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        static LONG raced_n;
+        if (!(InterlockedIncrement(&raced_n) % 240))
+            WARN("neutron dcomp: blit raced a swapchain resize (n=%ld), dropping frame\n", raced_n);
+        have_pixels = FALSE;
+    }
+    __ENDTRY
+
+    if (mt_entered)
+    {
+        ID3D10Multithread_Leave(mt);
+    }
+    if (mt) ID3D10Multithread_Release(mt);
+
+    if (!have_pixels)
+    {
+        free(packed);
+        goto done;
+    }
+
+    if (packed && p->cross_proc)
+    {
+        if (pbi_transport_publish(&p->transport, hwnd, p->hwnd, packed, desc.Width, desc.Height) &&
+            !p->t_first_deliver)
+        {
+            p->t_first_deliver = TRUE;
+            WARN("pbi-dcomp: publisher pid=%lu host=%p first frame %ux%u synchronous=%d\n",
+                 GetCurrentProcessId(), hwnd, desc.Width, desc.Height, p->synchronous);
+        }
+    }
+    else if (packed)
+    {
+        /* same-process target (e.g. the program-monitor canvas): the classic GDI blit works. */
+        memset(&bmi, 0, sizeof(bmi));
+        bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+        bmi.bmiHeader.biWidth = desc.Width;
+        bmi.bmiHeader.biHeight = -(LONG)desc.Height; /* top-down */
+        bmi.bmiHeader.biPlanes = 1;
+        bmi.bmiHeader.biBitCount = 32;
+        bmi.bmiHeader.biCompression = BI_RGB;
+
+        if ((hdc = GetDC(hwnd)))
+        {
+            GetClientRect(hwnd, &rc);
+            SetStretchBltMode(hdc, COLORONCOLOR);
+            StretchDIBits(hdc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
+                          0, 0, desc.Width, desc.Height,
+                          packed, &bmi, DIB_RGB_COLORS, SRCCOPY);
+            ReleaseDC(hwnd, hdc);
+        }
+    }
+    free(packed);
+
+done:
+    /* NEUTRON M1a: `staging` is a borrow of the cached p->staging — do NOT release it here.
+     * The cache is freed on size change (above), swapchain change, and unregister. */
+    if (ctx) ID3D11DeviceContext_Release(ctx);
+    if (d3d_device) ID3D11Device_Release(d3d_device);
+    if (backbuffer) ID3D11Texture2D_Release(backbuffer);
+}
+
+static DWORD WINAPI presentations_proc(void *arg)
+{
+    for (;;)
+    {
+        struct presentation *p;
+
+        EnterCriticalSection(&presentations_cs);
+        LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+        {
+            if (!p->synchronous && p->swapchain && p->present_hwnd && IsWindow(p->present_hwnd) && IsWindowVisible(p->present_hwnd))
+            {
+                /* NEUTRON R3 (resize glitch): pause blits while the target is mid-resize.
+                 * Stretching a stale readback into a changing client rect every tick is the
+                 * visible resize artifact; skip while the client size is changing and resume
+                 * once it settles (a frame drop here is already accepted behaviour). */
+                RECT rc = {0};
+                LONG cw = 0, ch = 0;
+                if (GetClientRect(p->present_hwnd, &rc)) { cw = rc.right - rc.left; ch = rc.bottom - rc.top; }
+                if (cw == p->last_client_w && ch == p->last_client_h)
+                    blit_swapchain_to_hwnd(p);
+                p->last_client_w = cw;
+                p->last_client_h = ch;
+            }
+        }
+        LeaveCriticalSection(&presentations_cs);
+        Sleep(16);
+    }
+    return 0;
+}
+
+static BOOL CALLBACK presentations_init(INIT_ONCE *once, void *param, void **ctx)
+{
+    InitializeCriticalSection(&presentations_cs);
+    presentations_thread = CreateThread(NULL, 0, presentations_proc, NULL, 0, NULL);
+    return TRUE;
+}
+
+static void register_presentation(HWND hwnd, IUnknown *content, BOOL synchronous)
+{
+    IDXGISwapChain *swapchain = NULL;
+    struct presentation *p;
+    HWND host, target;
+    BOOL target_cross_proc = FALSE;
+
+    if (!hwnd || !content)
+        return;
+    if (FAILED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain, (void **)&swapchain)))
+        return;
+
+    /* NEUTRON: only CEF/CEP panels (which have a WC_PLUGPLUG_HTMLEXTENSION host ancestor) get the
+     * subsurface treatment. We blit into that host and mark IT so win32u gives it its own window
+     * surface -> winewayland maps it as a subsurface ABOVE the parent's GPU (Vulkan/DXVK) client
+     * surface, making our GDI blit visible instead of hidden underneath. Non-CEF dcomp targets (e.g.
+     * the program-monitor canvas) return NULL here and are left completely untouched. */
+    host = find_cef_panel_host(hwnd);
+    if (synchronous && !host) { IDXGISwapChain_Release(swapchain); return; }
+    target = host ? host : hwnd;
+    {
+        DWORD tpid = 0;
+        GetWindowThreadProcessId(target, &tpid);
+        /* cross-process (CEF panel host owned by the Adobe app) -> shared-memory present path;
+         * same-process (program-monitor canvas) -> classic GDI blit. */
+        target_cross_proc = (tpid && tpid != GetCurrentProcessId());
+    }
+    {
+        /* NEUTRON diag: log the full ancestor chain (class + pid) once per hwnd so we can see whether a
+         * ForHwnd swapchain's CEF child resolves up to the Adobe-owned HTMLEXTENSION host. */
+        static HWND logged[32]; static int nlogged;
+        int li; BOOL seen = FALSE;
+        for (li = 0; li < nlogged; li++) if (logged[li] == hwnd) { seen = TRUE; break; }
+        if (!seen && nlogged < 32)
+        {
+            HWND a; int depth; char chain[512]; int off = 0;
+            logged[nlogged++] = hwnd;
+            for (a = hwnd, depth = 0; a && depth < 16; a = GetAncestor(a, GA_PARENT), depth++)
+            {
+                WCHAR cls[128]; DWORD apid = 0; char cn[128]; int j = 0;
+                if (GetClassNameW(a, cls, 128) <= 0) cls[0] = 0;
+                GetWindowThreadProcessId(a, &apid);
+                while (cls[j] && j < 40) { cn[j] = (char)cls[j]; j++; } cn[j] = 0;
+                off += snprintf(chain + off, sizeof(chain) - off, "%p[%s,pid%lu] <- ", a, cn, apid);
+                if (off > (int)sizeof(chain) - 80) break;
+            }
+            ERR("neutron-time: REGISTER hwnd=%p host=%p target=%p cross_proc=%d tick=%llu chain: %s\n",
+                hwnd, host, target, target_cross_proc, GetTickCount64(), chain);
+        }
+    }
+    /* Child windows already draw into their owner's surface in standard Wine.
+     * No cross-process SetWindowPos/FRAMECHANGED or Adobe-specific surface flags. */
+    InitOnceExecuteOnce(&presentations_once, presentations_init, NULL, NULL);
+
+    EnterCriticalSection(&presentations_cs);
+    LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+    {
+        if (p->hwnd == hwnd)
+        {
+            p->synchronous = synchronous;
+            p->present_hwnd = target;
+            p->cross_proc = target_cross_proc;
+            if (p->swapchain != swapchain)
+            {
+                /* NEUTRON gpu-churn fix: retire the old swapchain OUTSIDE the lock and
+                 * OFF this (the app's Present) thread — the final release can wedge
+                 * forever in DXVK's Presenter::destroyResources (see reaper above). */
+                IDXGISwapChain *old_swapchain = p->swapchain;
+                ID3D11Texture2D *old_staging = p->staging;
+                p->swapchain = swapchain; /* take QI ref */
+                /* NEUTRON M1a: swapchain (and possibly its D3D device) changed -> drop the cached staging. */
+                p->staging = NULL; p->staging_w = p->staging_h = 0;
+                /* NEUTRON perf gate: force a fresh present-count comparison on the new swapchain. */
+                p->have_present_count = FALSE;
+                LeaveCriticalSection(&presentations_cs);
+                release_swapchain_async(old_swapchain, old_staging);
+                return;
+            }
+            else IDXGISwapChain_Release(swapchain);
+            LeaveCriticalSection(&presentations_cs);
+            return;
+        }
+    }
+
+    if ((p = calloc(1, sizeof(*p))))
+    {
+        p->hwnd = hwnd;
+        p->synchronous = synchronous;
+        p->present_hwnd = target;
+        p->cross_proc = target_cross_proc;
+        p->swapchain = swapchain; /* take QI ref */
+        list_add_tail(&presentations, &p->entry);
+        TRACE("registered presentation hwnd %p (blit target %p) swapchain %p.\n", hwnd, target, swapchain);
+    }
+    else IDXGISwapChain_Release(swapchain);
+    LeaveCriticalSection(&presentations_cs);
+}
+
+static void unregister_presentations_for_hwnd(HWND hwnd)
+{
+    struct presentation *p, *next;
+    struct list removed = LIST_INIT(removed);
+
+    InitOnceExecuteOnce(&presentations_once, presentations_init, NULL, NULL);
+
+    EnterCriticalSection(&presentations_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(p, next, &presentations, struct presentation, entry)
+    {
+        if (p->hwnd == hwnd)
+        {
+            list_remove(&p->entry);
+            list_add_tail(&removed, &p->entry);
+        }
+    }
+    LeaveCriticalSection(&presentations_cs);
+
+    /* NEUTRON gpu-churn fix: do the final swapchain releases outside the lock and
+     * off this thread — same DXVK teardown wedge as in register_presentation. */
+    LIST_FOR_EACH_ENTRY_SAFE(p, next, &removed, struct presentation, entry)
+    {
+        list_remove(&p->entry);
+        release_swapchain_async(p->swapchain, p->staging);
+        pbi_transport_close(&p->transport);
+        free(p);
+    }
+}
+
+/* Walk a visual subtree and register any swapchain content against hwnd. */
+static void visual_register(struct composition_visual *visual, HWND hwnd)
+{
+    struct composition_visual *child;
+
+    if (visual->content)
+        register_presentation(hwnd, visual->content, FALSE);
+
+    LIST_FOR_EACH_ENTRY(child, &visual->children, struct composition_visual, entry)
+        visual_register(child, hwnd);
+}
