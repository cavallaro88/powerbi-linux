+/* ----------------------------------------------------------------------
+ * Presentation registry + background blit thread.
+ *
+ * DirectComposition apps update content by Present()ing the swapchain, not
+ * by Commit()ing every frame, so we cannot rely on Commit to drive the
+ * blit. Instead, when a swapchain is bound to a visual that is rooted in a
+ * target, we register (hwnd, swapchain) and a worker thread copies the
+ * swapchain's current frame onto the window continuously.
+ * -------------------------------------------------------------------- */
+
+struct presentation
+{
+    struct list entry;
+    HWND hwnd;         /* the window dcomp was asked to present into (a Chromium-internal child) */
+    HWND present_hwnd; /* where we actually blit: the WC_PLUGPLUG_HTMLEXTENSION panel host if this is
+                        * a CEF/CEP panel, else == hwnd. Only panel hosts are given a subsurface. */
+    IDXGISwapChain *swapchain;
+    struct pbi_transport transport; /* owner-process pixel delivery */
+    BOOL synchronous;
+    BOOL   cross_proc; /* present_hwnd owned by another process (CEF panel) -> use shared px path */
+    UINT   last_present_count; /* NEUTRON perf: skip the staging copy when the swapchain hasn't presented */
+    BOOL   have_present_count;
+    BOOL   t_first_present; /* NEUTRON cold-start timing: first present observed */
+    BOOL   t_first_deliver; /* NEUTRON cold-start timing: first frame delivered to shared mem */
+    ID3D11Texture2D *staging; /* NEUTRON perf: cached staging texture, recreated only on size change */
+    UINT   staging_w, staging_h;
+    LONG   last_client_w, last_client_h; /* NEUTRON: pause blits while the target is mid-resize */
+};
+
+/* Pick the closest ancestor owned by the main Power BI process. WebView2
+ * browser/renderer/GPU processes have different owners; the receiving control
+ * belongs to PBIDesktop. Never guess a target from another swapchain's HWND. */
+static HWND find_cef_panel_host(HWND hwnd)
+{
+    WCHAR owner_text[24], cls[128];
+    DWORD owner, pid;
+    HWND window, host = NULL;
+    int depth;
+    BOOL webview = FALSE;
+    if (!GetEnvironmentVariableW(L"PBI_COMPOSITION_OWNER_PID", owner_text, 24)) return NULL;
+    owner = wcstoul(owner_text, NULL, 10);
+    if (!owner) return NULL;
+    for (window = hwnd, depth = 0; window && depth < 24;
+         window = GetAncestor(window, GA_PARENT), depth++)
+    {
+        if (GetClassNameW(window, cls, 128) > 0 && !wcsncmp(cls, L"Chrome_", 7)) webview = TRUE;
+        GetWindowThreadProcessId(window, &pid);
+        if (!host && pid == owner) host = window;
+    }
+    return webview ? host : NULL;
+}
+
+static struct list presentations = LIST_INIT(presentations);
+static CRITICAL_SECTION presentations_cs;
+static INIT_ONCE presentations_once = INIT_ONCE_STATIC_INIT;
+static HANDLE presentations_thread;
