+/* Shared system cursors may be selected by a different process from the
+ * Wayland surface owner (e.g. an embedded browser). Resolve the resource in its
+ * owner, then load a local shared cursor; foreign GDI handles are never used. */
+static BOOL is_system_cursor_resource( UINT id )
+{
+    switch (id)
+    {
+    case OCR_NORMAL: case OCR_IBEAM: case OCR_WAIT: case OCR_CROSS:
+    case OCR_SIZENWSE: case OCR_SIZENESW: case OCR_SIZEWE: case OCR_SIZENS:
+    case OCR_SIZEALL: case OCR_NO: case OCR_HAND: case OCR_APPSTARTING: case OCR_HELP:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+UINT get_shared_system_cursor_resource( HCURSOR cursor )
+{
+    static const WCHAR user32[] = {'u','s','e','r','3','2','.','d','l','l',0};
+    struct cursoricon_object *obj;
+    UNICODE_STRING name;
+    UINT id = 0, count, start, i;
+
+    if (!(obj = get_icon_ptr( cursor ))) return 0;
+    if (obj->is_shared && !obj->is_icon && !obj->is_ani && obj->module.Length && IS_INTRESOURCE(obj->resname))
+    {
+        name = obj->module;
+        count = name.Length / sizeof(WCHAR);
+        for (start = count; start && name.Buffer[start - 1] != '\\'; start--);
+        name.Buffer += start;
+        name.Length -= start * sizeof(WCHAR);
+        if (name.Length == sizeof(user32) - sizeof(WCHAR))
+        {
+            for (i = 0; i < ARRAY_SIZE(user32) - 1; i++)
+            {
+                WCHAR c = name.Buffer[i];
+                if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+                if (c != user32[i]) break;
+            }
+            if (i == ARRAY_SIZE(user32) - 1 && is_system_cursor_resource( LOWORD(obj->resname) ))
+                id = LOWORD(obj->resname);
+        }
+    }
+    release_user_handle_ptr( obj );
+    return id;
+}
+
+static HCURSOR resolve_remote_system_cursor( HCURSOR cursor )
+{
+    static struct { HCURSOR cursor; DWORD pid, tid; UINT resource; } cache[64];
+    DWORD pid, tid;
+    DWORD_PTR result = 0;
+    UINT slot, resource = 0;
+
+    if (!get_user_handle_owner( cursor, NTUSER_OBJ_ICON, &pid, &tid ) || pid == GetCurrentProcessId()) return 0;
+    slot = ((ULONG_PTR)cursor >> 1) % ARRAY_SIZE(cache);
+    user_lock();
+    if (cache[slot].cursor == cursor && cache[slot].pid == pid && cache[slot].tid == tid)
+        resource = cache[slot].resource;
+    user_unlock();
+    if (!resource)
+    {
+        if (!send_internal_message_timeout( pid, tid, WM_WINE_GET_SYSTEM_CURSOR, HandleToUlong(cursor), 0,
+                                            SMTO_BLOCK | SMTO_ABORTIFHUNG, 50, &result ) ||
+            !is_system_cursor_resource( result )) return 0;
+        resource = result;
+        user_lock();
+        cache[slot].cursor = cursor;
+        cache[slot].pid = pid;
+        cache[slot].tid = tid;
+        cache[slot].resource = resource;
+        user_unlock();
+    }
+    return LoadImageW( 0, MAKEINTRESOURCEW(resource), IMAGE_CURSOR, 0, 0, LR_SHARED | LR_DEFAULTSIZE );
+}
