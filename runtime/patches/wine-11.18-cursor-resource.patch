+/* Read the owner of a generation-validated USER handle without dereferencing
+ * another process's client object. No pointer is transferred across processes. */
+BOOL get_user_handle_owner( HANDLE handle, unsigned short type, DWORD *pid, DWORD *tid )
+{
+    struct user_entry entry;
+    if (!get_user_entry( handle, type, &entry, &handle )) return FALSE;
+    *pid = entry.pid;
+    *tid = entry.tid;
+    return TRUE;
+}
