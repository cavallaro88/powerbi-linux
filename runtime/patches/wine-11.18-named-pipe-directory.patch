+static void named_pipe_dir_query( struct named_pipe_device_file *dir )
+{
+    const struct pipe_dir_query *query = get_req_data();
+    data_size_t size = get_req_data_size(), mask_len = 0, total, entry_size, name_len;
+    struct pipe_dir_reply *header;
+    struct pipe_dir_entry *entry;
+    struct named_pipe *pipe;
+    struct object *obj;
+    unsigned int i, count;
+    const WCHAR *name;
+    char *buffer;
+    int fresh;
+
+    if (size < sizeof(*query))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (query->flags & PIPE_DIR_MASK) mask_len = (size - sizeof(*query)) & ~(data_size_t)(sizeof(WCHAR) - 1);
+
+    /* as on Windows, the mask of the first query is kept; a restart with a new mask replaces it */
+    fresh = !dir->dir_started;
+    if (!dir->dir_started || ((query->flags & PIPE_DIR_RESTART) && (query->flags & PIPE_DIR_MASK)))
+    {
+        WCHAR *mask = NULL;
+
+        if (mask_len && !(mask = memdup( query + 1, mask_len ))) return;
+        free( dir->dir_mask );
+        dir->dir_mask = mask;
+        dir->dir_mask_len = mask_len;
+        dir->dir_started = 1;
+    }
+    if (query->flags & PIPE_DIR_RESTART) dir->dir_index = 0;
+    dir->dir_index += query->advance;
+
+    /* a commit of the consumed entries asks for no reply */
+    if (get_reply_max_size() < sizeof(*header)) return;
+
+    total = (sizeof(*header) + dir->dir_mask_len + 3) & ~3;
+    if (total > get_reply_max_size())
+    {
+        set_error( STATUS_BUFFER_TOO_SMALL );
+        return;
+    }
+    for (count = 0; (obj = find_object_index( dir->device->pipes, dir->dir_index + count )); count++)
+    {
+        name_len = 0;
+        get_object_name( obj, &name_len );
+        release_object( obj );
+        entry_size = (sizeof(*entry) + name_len + 3) & ~3;
+        if (total + entry_size > get_reply_max_size())
+        {
+            /* an empty reply means the end of the directory */
+            if (!count) set_error( STATUS_BUFFER_TOO_SMALL );
+            break;
+        }
+        total += entry_size;
+    }
+    if (!count && get_error()) return;
+
+    if (!(buffer = set_reply_data_size( total ))) return;
+    memset( buffer, 0, total );
+    header = (struct pipe_dir_reply *)buffer;
+    header->mask_len = dir->dir_mask_len;
+    header->count = count;
+    header->fresh = fresh;
+    if (dir->dir_mask_len) memcpy( header + 1, dir->dir_mask, dir->dir_mask_len );
+
+    total = (sizeof(*header) + dir->dir_mask_len + 3) & ~3;
+    for (i = 0; i < count; i++)
+    {
+        obj = find_object_index( dir->device->pipes, dir->dir_index + i );
+        assert( obj && obj->ops == &named_pipe_ops );
+        pipe = (struct named_pipe *)obj;
+        name_len = 0;
+        name = get_object_name( obj, &name_len );
+        entry = (struct pipe_dir_entry *)(buffer + total);
+        entry->name_len = name_len;
+        entry->instances = pipe->instances;
+        entry->max_instances = pipe->maxinstances;
+        if (name_len) memcpy( entry + 1, name, name_len );
+        total += (sizeof(*entry) + name_len + 3) & ~3;
+        release_object( obj );
+    }
+}
