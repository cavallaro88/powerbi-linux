+/* Wine extension, shared with server/named_pipe.c: the server lists the pipes of the named pipe
+ * root directory, which has no Unix directory behind it. The search mask and the position
+ * belong to the server's file object, as on Windows; ntdll matches the mask and formats. */
+#define FSCTL_WINE_QUERY_PIPE_DIRECTORY CTL_CODE(FILE_DEVICE_NAMED_PIPE, 0x800, METHOD_BUFFERED, FILE_READ_ACCESS)
+#define PIPE_DIR_RESTART 0x1  /* start again from the first pipe */
+#define PIPE_DIR_MASK    0x2  /* a search mask follows the query */
+
+struct pipe_dir_query
+{
+    unsigned int flags;
+    unsigned int advance;     /* entries the caller consumed from the previous reply */
+};
+
+struct pipe_dir_reply
+{
+    unsigned int mask_len;    /* search mask in bytes, then padded to 4 bytes; 0 matches all */
+    unsigned int count;       /* entries after the mask */
+    unsigned int fresh;       /* this query started the enumeration */
+};
+
+struct pipe_dir_entry
+{
+    unsigned int name_len;    /* name in bytes, then padded to 4 bytes */
+    unsigned int instances;
+    unsigned int max_instances;
+};
+
+
+/***********************************************************************
+ *           is_named_pipe_root
+ *
+ * Check whether a handle is the root directory of the named pipe device (\\.\pipe\).
+ */
+static BOOL is_named_pipe_root( HANDLE handle )
+{
+    static const WCHAR rootW[] = {'\\','D','e','v','i','c','e','\\','N','a','m','e','d','P','i','p','e','\\'};
+    char buffer[sizeof(OBJECT_NAME_INFORMATION) + sizeof(rootW) + sizeof(WCHAR)];
+    OBJECT_NAME_INFORMATION *info = (OBJECT_NAME_INFORMATION *)buffer;
+    ULONG size;
+
+    if (NtQueryObject( handle, ObjectNameInformation, info, sizeof(buffer), &size )) return FALSE;
+    return info->Name.Length == sizeof(rootW) &&
+           !wcsnicmp( info->Name.Buffer, rootW, ARRAY_SIZE(rootW) );
+}
+
+
+/***********************************************************************
+ *           get_pipe_dir_entry
+ *
+ * Format one pipe of the named pipe root directory; the counterpart of get_dir_data_entry.
+ * Like Windows, report the current instances as the size and the maximum as the allocation.
+ */
+static NTSTATUS get_pipe_dir_entry( const struct pipe_dir_entry *entry, void *info_ptr, IO_STATUS_BLOCK *io,
+                                    ULONG max_length, FILE_INFORMATION_CLASS class,
+                                    union file_directory_info **last_info )
+{
+    union file_directory_info *info;
+    ULONG name_len = entry->name_len, start, dir_size;
+
+    start = dir_info_align( io->Information );
+    dir_size = dir_info_size( class, 0 );
+    if (start + dir_size > max_length) return STATUS_MORE_ENTRIES;
+
+    max_length -= start + dir_size;
+    /* if this is not the first entry, fail; the first entry is always returned (but truncated) */
+    if (*last_info && name_len > max_length) return STATUS_MORE_ENTRIES;
+
+    info = (union file_directory_info *)((char *)info_ptr + start);
+    memset( info, 0, dir_size );
+    if (class != FileNamesInformation)
+    {
+        info->dir.EndOfFile.QuadPart = entry->instances;
+        info->dir.AllocationSize.QuadPart = entry->max_instances;
+        info->dir.FileAttributes = FILE_ATTRIBUTE_NORMAL;
+    }
+
+    switch (class)
+    {
+    case FileDirectoryInformation:           info->dir.FileNameLength = name_len; break;
+    case FileFullDirectoryInformation:       info->full.FileNameLength = name_len; break;
+    case FileIdFullDirectoryInformation:     info->id_full.FileNameLength = name_len; break;
+    case FileBothDirectoryInformation:       info->both.FileNameLength = name_len; break;
+    case FileIdBothDirectoryInformation:     info->id_both.FileNameLength = name_len; break;
+    case FileIdExtdBothDirectoryInformation: info->extd_both.FileNameLength = name_len; break;
+    case FileIdGlobalTxDirectoryInformation: info->id_tx.FileNameLength = name_len; break;
+    case FileNamesInformation:               info->names.FileNameLength = name_len; break;
+    default:
+        assert(0);
+        return 0;
+    }
+
+    memcpy( (char *)info + dir_size, entry + 1, min( name_len, max_length ) );
+    io->Information = start + dir_size + min( name_len, max_length );
+    if (*last_info) (*last_info)->next = (char *)info - (char *)*last_info;
+    *last_info = info;
+    return name_len > max_length ? STATUS_BUFFER_OVERFLOW : STATUS_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           query_pipe_directory
+ *
+ * NtQueryDirectoryFile for the named pipe root directory.
+ */
+static NTSTATUS query_pipe_directory( HANDLE handle, IO_STATUS_BLOCK *io, void *buffer, ULONG length,
+                                      FILE_INFORMATION_CLASS class, BOOLEAN single_entry,
+                                      const UNICODE_STRING *mask, BOOLEAN restart_scan )
+{
+    union file_directory_info *last_info = NULL;
+    const struct pipe_dir_reply *reply;
+    const struct pipe_dir_entry *entry;
+    struct pipe_dir_query *query;
+    IO_STATUS_BLOCK32 io32;
+    IO_STATUS_BLOCK iosb;
+    UNICODE_STRING stored;
+    ULONG query_size, pos, i;
+    /* room for the largest mask and the largest name; the server checks the reply buffer
+     * like a client buffer, so it must be virtual memory rather than the Unix heap */
+    SIZE_T reply_size = 2 * (sizeof(struct pipe_dir_reply) + UNICODE_STRING_MAX_CHARS * sizeof(WCHAR) + 4);
+    BOOL first = TRUE, fresh = FALSE, done = FALSE;
+    NTSTATUS status;
+    char *out = NULL;
+
+    query_size = sizeof(*query) + (mask ? mask->Length : 0);
+    if (!(query = malloc( query_size ))) return STATUS_NO_MEMORY;
+    if ((status = NtAllocateVirtualMemory( NtCurrentProcess(), (void **)&out, 0, &reply_size,
+                                           MEM_COMMIT, PAGE_READWRITE )))
+    {
+        free( query );
+        return status;
+    }
+    query->flags = (restart_scan ? PIPE_DIR_RESTART : 0) | (mask ? PIPE_DIR_MASK : 0);
+    query->advance = 0;
+    if (mask) memcpy( query + 1, mask->Buffer, mask->Length );
+
+    io->Information = 0;
+    for (;;)
+    {
+        /* the 32-bit iosb is filled for overlapped file handles */
+        iosb.Pointer = &io32;
+        status = NtDeviceIoControlFile( handle, NULL, NULL, NULL, &iosb, FSCTL_WINE_QUERY_PIPE_DIRECTORY,
+                                        query, query_size, out, reply_size );
+        if (status) break;
+        reply = (const struct pipe_dir_reply *)out;
+        if (iosb.Information < sizeof(*reply)) break;
+        if (first) fresh = reply->fresh;
+        first = FALSE;
+        query->flags = query->advance = 0;
+        query_size = sizeof(*query);
+        if (!reply->count) break;  /* no more pipes */
+
+        stored.Buffer = (WCHAR *)(reply + 1);
+        stored.Length = stored.MaximumLength = reply->mask_len;
+        pos = (sizeof(*reply) + reply->mask_len + 3) & ~3;
+        for (i = 0; i < reply->count && !done; i++)
+        {
+            entry = (const struct pipe_dir_entry *)(out + pos);
+            pos += (sizeof(*entry) + entry->name_len + 3) & ~3;
+            if (stored.Length && !match_filename( (const WCHAR *)(entry + 1), entry->name_len / sizeof(WCHAR), &stored ))
+            {
+                query->advance++;
+                continue;
+            }
+            status = get_pipe_dir_entry( entry, buffer, io, length, class, &last_info );
+            if (status == STATUS_MORE_ENTRIES)
+            {
+                done = TRUE;
+                break;
+            }
+            query->advance++;
+            if (status == STATUS_BUFFER_OVERFLOW || single_entry) done = TRUE;
+        }
+        if (done)
+        {
+            /* commit the consumed entries; the next query starts after them */
+            iosb.Pointer = &io32;
+            if (query->advance)
+                NtDeviceIoControlFile( handle, NULL, NULL, NULL, &iosb, FSCTL_WINE_QUERY_PIPE_DIRECTORY,
+                                       query, sizeof(*query), NULL, 0 );
+            break;
+        }
+    }
+    free( query );
+    reply_size = 0;
+    NtFreeVirtualMemory( NtCurrentProcess(), (void **)&out, &reply_size, MEM_RELEASE );
+
+    if (status == STATUS_MORE_ENTRIES) status = STATUS_SUCCESS;
+    if (status && status != STATUS_BUFFER_OVERFLOW)
+    {
+        if (!last_info) return status;  /* the server refused the query */
+        status = STATUS_SUCCESS;  /* a later batch failed: return the entries so far */
+    }
+    if (!last_info) status = fresh ? STATUS_NO_SUCH_FILE : STATUS_NO_MORE_FILES;
+    if (status != STATUS_NO_SUCH_FILE) io->Status = status;
+    TRACE( "=> %x (%ld)\n", status, io->Information );
+    return status;
+}
+
