+        TRACE("scale by 1000\n");
+      }
+      else
+      {
+        num_header->flags |= FMT_FLAG_THOUSANDS;
+        TRACE("thousands sep\n");
+      }
       pFormat++;
       fmt_state &= ~FMT_STATE_OPEN_COPY;
-      TRACE("thousands sep\n");
     }
