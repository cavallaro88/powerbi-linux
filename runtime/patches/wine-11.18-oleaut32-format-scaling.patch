oleaut32: divide by 1000 for scaling commas in number formats

VarTokenizeFormatString() treated every ',' in a number format as the
thousands separator flag. A comma with no digit placeholder after it in the
whole number part (immediately left of the decimal point, or at the end of
the digits) scales the number by 1000 instead, so "$#,0,K" formats 4376023
as "$4,376K". Wine returned "$4,376,023K". Analysis Services uses these
functions for the DAX FORMAT function, so FORMAT(x, "#,0,K") in Power BI
Desktop showed unscaled thousands.
The tokenizer now counts scaling commas in the number header's divisor byte
and VARIANT_FormatNumber() lowers the exponent by 3 for each. Commas after
the decimal point keep the old behaviour; their Windows result was not
measured.
Rounding a number below one up to the first kept digit wrote the leading 1
and then cleared it ("0" formatted 0.6 as "0"), which the scaling makes
common (600 as "#,0,K" gave "0K"); the 1 is now written last.
The "$4,376K" result is the one Desktop gives on Windows; the other new test
results follow the documented VBA Format rules and were not measured on
Windows.
Wine-derived change: LGPL-2.1-or-later.

--- a/dlls/oleaut32/varformat.c
+++ b/dlls/oleaut32/varformat.c
@@ -192,7 +192,7 @@
 {
   BYTE   flags;      /* PERCENT, EXPONENT, THOUSANDS, BOOL */
   BYTE   multiplier; /* Multiplier, 100 for percentages */
-  BYTE   divisor;    /* Divisor, 1000 if '%%' was used */
+  BYTE   divisor;    /* Scaling commas: divide by 1000 for each */
   BYTE   whole;      /* Number of digits before the decimal point */
   BYTE   fractional; /* Number of digits after the decimal point */
 } FMT_NUMBER_HEADER;
@@ -443,6 +443,29 @@
 #define FMT_STATE_SEEN_HOURS    0x4 /* See the hh specifier */
 #define FMT_STATE_WROTE_MINUTES 0x8 /* Wrote minutes */
 
+/* Whether a '0' or '#' digit placeholder follows in the whole number part
+ * of this format section. Quoted and escaped literals are skipped. */
+static BOOL VARIANT_WholeDigitFollows(LPCOLESTR pFormat)
+{
+  while (*pFormat && *pFormat != ';' && *pFormat != '.')
+  {
+    if (*pFormat == '0' || *pFormat == '#')
+      return TRUE;
+    if (*pFormat == '"')
+    {
+      pFormat++;
+      while (*pFormat && *pFormat != '"')
+        pFormat++;
+      if (!*pFormat)
+        break;
+    }
+    else if (*pFormat == '\\' && pFormat[1])
+      pFormat++;
+    pFormat++;
+  }
+  return FALSE;
+}
+
