             initial_configure = surface->current.serial == 0;
             surface->pending.serial = serial;
+            /* The sync's answer is handled on this thread in the order the
+             * compositor sent it: still outstanding, it follows this configure. */
+            surface->pending.before_maximize = surface->maximize_sync != NULL;
             surface->requested = surface->pending;
             memset(&surface->pending, 0, sizeof(surface->pending));
