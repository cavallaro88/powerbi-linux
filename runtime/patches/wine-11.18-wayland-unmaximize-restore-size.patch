 }
 
+static void maximize_sync_done(void *data, struct wl_callback *callback, uint32_t time)
+{
+    struct wayland_win_data *win_data;
+    struct wayland_surface *surface;
+
+    /* Handled on the event thread, in order with the configure events. */
+    if ((win_data = wayland_win_data_get(data)))
+    {
+        if ((surface = win_data->wayland_surface) && surface->maximize_sync == callback)
+            surface->maximize_sync = NULL;
+        wayland_win_data_release(win_data);
+    }
+    wl_callback_destroy(callback);
+}
+
+static const struct wl_callback_listener maximize_sync_listener =
+{
+    maximize_sync_done
+};
+
+/**********************************************************************
+ *          wayland_surface_sync_maximize
+ *
+ * Mark the configures the compositor sends before it receives the request
+ * to be maximized that the caller sends next. Called with the window data
+ * lock held; a sync still unanswered serves a repeated request. The
+ * callback is on the event thread's queue, so its answer is handled in
+ * order with the configures. It keeps the window handle, not the surface,
+ * and is destroyed when answered, also after the surface has gone.
+ */
+void wayland_surface_sync_maximize(struct wayland_surface *surface)
+{
+    struct wl_display *display = process_wayland.wl_display;
+    struct wl_event_queue *idle;
+    struct wl_display *wrapper;
+
+    if (surface->maximize_sync) return;
+    if (!(idle = wl_display_create_queue(display))) return;
+    if (!(wrapper = wl_proxy_create_wrapper(display)))
+    {
+        wl_event_queue_destroy(idle);
+        return;
+    }
+    wl_proxy_set_queue((struct wl_proxy *)wrapper, process_wayland.wl_event_queue);
+    /* An event without a listener is dropped. A reader prepared on an empty
+     * queue keeps every thread from reading the socket until it is
+     * cancelled, so the answer cannot be read before the listener is set. */
+    if (wl_display_prepare_read_queue(display, idle) == 0)
+    {
+        if ((surface->maximize_sync = wl_display_sync(wrapper)))
+            wl_callback_add_listener(surface->maximize_sync, &maximize_sync_listener, surface->hwnd);
+        wl_display_cancel_read(display);
+    }
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_event_queue_destroy(idle);
+}
+
