-    BOOL fixed_dialog;
+    BOOL fixed_dialog, restore = FALSE, maximize_requested;
+    WINDOWPLACEMENT placement = {.length = sizeof(placement)};
 
     /* Read the window before taking the window data lock: win32u calls the
      * driver with its own lock held, so the order must not be reversed. */
@@ -666,6 +670,13 @@
     rect = map_rect_from_surface(surface, rect);
     OffsetRect(&rect, data->rects.window.left, data->rects.window.top);
 
+    /* The compositor sent this configure before it saw the window's last
+     * request to be maximized; its answer follows. Not for the initial
+     * configure: the compositor decides how to map the window from the size
+     * it gets now, and a window left at its maximized rectangle is mapped as
+     * a floating window of a fixed size. */
+    maximize_requested = surface->processing.before_maximize && surface->current.serial;
+
     wayland_win_data_release(data);
 
     TRACE("processing=%dx%d,%#x\n", width, height, state);
@@ -677,6 +688,25 @@
     if (rect.left == rect.right || rect.bottom == rect.top) flags |= SWP_NOSIZE;
 
     style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+
+    /* A configure that ends the maximized state without giving a size leaves
+     * the size to the window. Use the size of its restored placement, as a
+     * restore does. At the size it had while maximized the window would still
+     * cover its monitor: it would count as fullscreen, be announced with a
+     * fixed size, and a tiling compositor maps such a window floating.
+     * Not while the window's own request to be maximized is unanswered: the
+     * compositor's answer follows and would resize it straight back. */
+    if ((flags & SWP_NOSIZE) && (style & WS_MAXIMIZE) && !maximize_requested &&
+        !(state & (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED |
+                   WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN)) &&
+        NtUserGetWindowPlacement(hwnd, &placement) &&
+        !IsRectEmpty(&placement.rcNormalPosition))
+    {
+        TRACE("hwnd=%p leaving the maximized state without a size, restoring %s\n",
+              hwnd, wine_dbgstr_rect(&placement.rcNormalPosition));
+        restore = TRUE;
+    }
+
     if (!(state & WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED) != !(style & WS_MAXIMIZE)
         && !(state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
         NtUserSetWindowLong(hwnd, GWL_STYLE, style ^ WS_MAXIMIZE, FALSE);
@@ -692,7 +722,13 @@
         flags |= SWP_NOSENDCHANGING;
     }
 
-    NtUserSetRawWindowPos(hwnd, rect, flags, FALSE);
+    if (restore)
+        NtUserSetWindowPos(hwnd, 0, 0, 0,
+                           placement.rcNormalPosition.right - placement.rcNormalPosition.left,
+                           placement.rcNormalPosition.bottom - placement.rcNormalPosition.top,
+                           flags & ~SWP_NOSIZE);
+    else
+        NtUserSetRawWindowPos(hwnd, rect, flags, FALSE);
 }
 
